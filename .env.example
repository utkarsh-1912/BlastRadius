# --- AWS ---
AWS_REGION=us-east-1
# Real account: leave AWS_ENDPOINT_URL unset and configure credentials the normal
# boto3 way (AWS_PROFILE, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, or an
# instance/role credential). No AWS account yet? Run a local moto_server and
# point everything at it instead — see README "No AWS account?" section:
# AWS_ENDPOINT_URL=http://localhost:5555
# AWS_ACCESS_KEY_ID=testing
# AWS_SECRET_ACCESS_KEY=testing
AWS_PROFILE=

# CloudTrail: a brand-new account won't have 90 days of rich history yet, so
# this defaults to a labeled demo export (server/data/demo_cloudtrail_events.json).
# Set to false once your account has real history to replay against.
USE_DEMO_CLOUDTRAIL=true

# --- Blast Radius AWS IAM Tool Layer (the MCP server TrueForge calls) ---
IAM_MCP_PORT=8792
# Random 32+ char secret; TrueForge sends it as a Bearer header, the agent never sees it.
IAM_MCP_TOKEN=change-me

# --- TrueForge ---
TRUEFORGE_BASE_URL=http://localhost:8790
DAYTONA_API_KEY=

# --- Model (pick one) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
MODEL_ID=claude-sonnet-5
# MODEL_FQN=

# --- Blast Radius API server ---
BLAST_RADIUS_API_PORT=8010

# --- Next.js frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
