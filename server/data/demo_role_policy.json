{
  "role_name": "data-pipeline-role",
  "trust_policy": {
    "Version": "2012-10-17",
    "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }]
  },
  "inline_policy_name": "data-pipeline-permissions",
  "inline_policy_document": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "S3DataAccess",
        "Effect": "Allow",
        "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
        "Resource": ["arn:aws:s3:::pipeline-input/*", "arn:aws:s3:::pipeline-output/*", "arn:aws:s3:::pipeline-input", "arn:aws:s3:::pipeline-output"]
      },
      {
        "Sid": "CheckpointTable",
        "Effect": "Allow",
        "Action": ["dynamodb:Scan", "dynamodb:DeleteTable"],
        "Resource": "arn:aws:dynamodb:us-east-1:123456789012:table/pipeline-checkpoints"
      },
      {
        "Sid": "AlertsTopic",
        "Effect": "Allow",
        "Action": ["sns:Publish"],
        "Resource": "arn:aws:sns:us-east-1:123456789012:pipeline-alerts"
      },
      {
        "Sid": "PassExecutionRole",
        "Effect": "Allow",
        "Action": ["iam:PassRole"],
        "Resource": "*"
      }
    ]
  },
  "_comment": "S3 actions use path patterns rather than '*' Resource so the local evaluator's resource-wildcard matching gets meaningfully exercised, not just action matching. dynamodb:DeleteTable and s3:DeleteObject/ListBucket have zero matching events in demo_cloudtrail_events.json -> confidently safe. sns:Publish was used once, 160 days ago -> flagged, not auto-approved (see docs/architecture.md). iam:PassRole is excluded by understand.py's default exclusion list regardless of usage."
}
